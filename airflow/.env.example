# Airflow (e do Postgres que serve de metastore dele)

# Postgres — banco interno de metadados do Airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflowadmin
POSTGRES_DB=airflow

# Airflow
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=
AIRFLOW_JWT_SECRET=

# Usado pela DAG pra chamar a API do BookStack e pra localizar o MariaDB
# (ex: rotina de backup do bookstack_service)
BOOKSTACK_URL=http://bookstack:80
MARIADB_HOST=mariadb_service


DB_ETL_USER=airflow_etl
DB_ETL_PASSWORD=forte_etl